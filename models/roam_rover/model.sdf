
<?xml version="1.0"?>
<sdf version="1.10">
  <model name="roam_rover">
    <static>false</static>

    <!-- ==================================== -->
    <!-- CHASSIS                              -->
    <!-- ==================================== -->

    <!-- Chassis reference frame at center -->
    <link name="base_link">
      <inertial>
        <mass>18</mass>
        <inertia>
          <ixx>0.73</ixx>
          <iyy>1.45</iyy>
          <izz>1.86</izz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.70 0.28 0.15</size>
          </box>
        </geometry>
      </collision>

      <visual name="original_chassis_mesh">
        <geometry>
          <mesh>
            <uri>model://roam_rover/meshes/chassis.dae</uri>
            <scale>4 4 4</scale>
          </mesh>
        </geometry>
      </visual>

      <visual name="electronics_enclosure">
        <pose>0 0 0.11 0 0 0</pose>
        <geometry>
          <box>
            <size>0.48 0.24 0.12</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.20 0.24 1</ambient>
          <diffuse>0.12 0.20 0.24 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ==================================== -->
    <!-- FRONT LEFT WHEEL                     -->
    <!-- ==================================== -->

    <link name="front_left_wheel">
      <pose relative_to="base_link">0.308 0.248 -0.12 0 0 0</pose>

      <inertial>
        <mass>1.4</mass>
        <inertia>
          <ixx>0.0085</ixx>
          <iyy>0.0040</iyy>
          <izz>0.0085</izz>
        </inertia>
      </inertial>

      <collision name="tire_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.105</radius>
            <length>0.065</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.55</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="tire_mesh">
        <geometry>
          <mesh>
            <uri>model://roam_rover/meshes/wheel.dae</uri>
            <scale>4 4 4</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <effort>35</effort>
          <velocity>12</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- ==================================== -->
    <!-- FRONT RIGHT WHEEL                    -->
    <!-- ==================================== -->

    <link name="front_right_wheel">
      <pose relative_to="base_link">0.308 -0.208 -0.12 0 0 0</pose>

      <inertial>
        <mass>1.4</mass>
        <inertia>
          <ixx>0.0085</ixx>
          <iyy>0.0040</iyy>
          <izz>0.0085</izz>
        </inertia>
      </inertial>

      <collision name="tire_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.105</radius>
            <length>0.065</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.55</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="tire_mesh">
        <geometry>
          <mesh>
            <uri>model://roam_rover/meshes/wheel.dae</uri>
            <scale>4 4 4</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <effort>35</effort>
          <velocity>12</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- ==================================== -->
    <!-- REAR LEFT WHEEL                      -->
    <!-- ==================================== -->

    <link name="rear_left_wheel">
      <pose relative_to="base_link">-0.308 0.248 -0.12 0 0 0</pose>

      <inertial>
        <mass>1.4</mass>
        <inertia>
          <ixx>0.0085</ixx>
          <iyy>0.0040</iyy>
          <izz>0.0085</izz>
        </inertia>
      </inertial>

      <collision name="tire_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.105</radius>
            <length>0.065</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.55</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="tire_mesh">
        <geometry>
          <mesh>
            <uri>model://roam_rover/meshes/wheel.dae</uri>
            <scale>4 4 4</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <effort>35</effort>
          <velocity>12</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- ==================================== -->
    <!-- REAR RIGHT WHEEL                     -->
    <!-- ==================================== -->

    <link name="rear_right_wheel">
      <pose relative_to="base_link">-0.308 -0.208 -0.12 0 0 0</pose>

      <inertial>
        <mass>1.4</mass>
        <inertia>
          <ixx>0.0085</ixx>
          <iyy>0.0040</iyy>
          <izz>0.0085</izz>
        </inertia>
      </inertial>

      <collision name="tire_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.105</radius>
            <length>0.065</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.55</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="tire_mesh">
        <geometry>
          <mesh>
            <uri>model://roam_rover/meshes/wheel.dae</uri>
            <scale>4 4 4</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <effort>35</effort>
          <velocity>12</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- ==================================== -->
    <!-- FOUR-WHEEL SKID-STEER CONTROLLER     -->
    <!-- ==================================== -->

    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <!-- Independent left and right wheel pairs -->
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>

      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <!-- Physical wheel geometry -->
      <wheel_separation>0.456</wheel_separation>
      <wheel_radius>0.105</wheel_radius>

      <!-- ROS/Gazebo command interfaces -->
      <topic>/rover/cmd_vel</topic>
      <odom_topic>/rover/odom</odom_topic>

      <!-- Velocity limits -->
      <max_linear_velocity>1.0</max_linear_velocity>
      <min_linear_velocity>-1.0</min_linear_velocity>

      <max_angular_velocity>5.0</max_angular_velocity>
      <min_angular_velocity>-5.0</min_angular_velocity>

      <!-- Acceleration limits -->
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <min_linear_acceleration>-1.5</min_linear_acceleration>

      <max_angular_acceleration>8.0</max_angular_acceleration>
      <min_angular_acceleration>-8.0</min_angular_acceleration>

    </plugin>

    <!-- ==================================== -->
    <!-- WHEEL JOINT STATE PUBLISHER          -->
    <!-- ==================================== -->

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">

      <topic>/rover/wheel_joint_states</topic>

      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>

      <update_rate>50</update_rate>
    </plugin>

  </model>
</sdf>
