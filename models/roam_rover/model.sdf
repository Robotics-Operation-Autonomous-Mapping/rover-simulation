<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.10">
  <model name="roam_rover">
    <static>false</static>
    <link name="base_link">
      <inertial>
        <mass>18</mass>
        <inertia>
          <ixx>0.73</ixx>
          <iyy>1.45</iyy>
          <izz>1.86</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.70 0.28 0.15</size>
          </box>
        </geometry>
      </collision>
      <visual name="original_chassis_mesh">
        <geometry>
          <mesh>
            <uri>model://roam_rover/meshes/chassis.dae</uri>
            <scale>4 4 4</scale>
          </mesh>
        </geometry>
      </visual>
      <visual name="electronics_enclosure">
        <pose>0 0 0.11 0 0 0</pose>
        <geometry>
          <box>
            <size>0.48 0.24 0.12</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.20 0.24 1</ambient>
          <diffuse>0.12 0.20 0.24 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="front_left_wheel">
      <pose relative_to="base_link">0.308 0.248 -0.12 0 0 0</pose>
      <inertial>
        <mass>1.4</mass>
        <inertia>
          <ixx>0.0085</ixx>
          <iyy>0.0040</iyy>
          <izz>0.0085</izz>
        </inertia>
      </inertial>
      <collision name="tire_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.105</radius>
            <length>0.065</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.55</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="tire_mesh">
        <geometry>
          <mesh>
            <uri>model://roam_rover/meshes/wheel.dae</uri>
            <scale>4 4 4</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <effort>35</effort>
          <velocity>12</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>
    <link name="front_right_wheel">
      <pose relative_to="base_link">0.308 -0.208 -0.12 0 0 0</pose>
      <inertial>
        <mass>1.4</mass>
        <inertia>
          <ixx>0.0085</ixx>
          <iyy>0.0040</iyy>
          <izz>0.0085</izz>
        </inertia>
      </inertial>
      <collision name="tire_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.105</radius>
            <length>0.065</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.55</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="tire_mesh">
        <geometry>
          <mesh>
            <uri>model://roam_rover/meshes/wheel.dae</uri>
            <scale>4 4 4</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <effort>35</effort>
          <velocity>12</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>
    <link name="rear_left_wheel">
      <pose relative_to="base_link">-0.308 0.248 -0.12 0 0 0</pose>
      <inertial>
        <mass>1.4</mass>
        <inertia>
          <ixx>0.0085</ixx>
          <iyy>0.0040</iyy>
          <izz>0.0085</izz>
        </inertia>
      </inertial>
      <collision name="tire_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.105</radius>
            <length>0.065</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.55</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="tire_mesh">
        <geometry>
          <mesh>
            <uri>model://roam_rover/meshes/wheel.dae</uri>
            <scale>4 4 4</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <effort>35</effort>
          <velocity>12</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>
    <link name="rear_right_wheel">
      <pose relative_to="base_link">-0.308 -0.208 -0.12 0 0 0</pose>
      <inertial>
        <mass>1.4</mass>
        <inertia>
          <ixx>0.0085</ixx>
          <iyy>0.0040</iyy>
          <izz>0.0085</izz>
        </inertia>
      </inertial>
      <collision name="tire_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.105</radius>
            <length>0.065</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.55</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="tire_mesh">
        <geometry>
          <mesh>
            <uri>model://roam_rover/meshes/wheel.dae</uri>
            <scale>4 4 4</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <effort>35</effort>
          <velocity>12</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.456</wheel_separation>
      <wheel_radius>0.105</wheel_radius>
      <topic>/rover/cmd_vel</topic>
      <odom_topic>/rover/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <tf_topic>/rover/wheel_tf</tf_topic>
      <max_linear_velocity>1.0</max_linear_velocity>
      <min_linear_velocity>-1.0</min_linear_velocity>
      <max_angular_velocity>5.0</max_angular_velocity>
      <min_angular_velocity>-5.0</min_angular_velocity>
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <min_linear_acceleration>-1.5</min_linear_acceleration>
      <max_angular_acceleration>8.0</max_angular_acceleration>
      <min_angular_acceleration>-8.0</min_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>100</odom_publish_frequency>
      <odom_topic>/rover/ground_truth/odometry</odom_topic>
      <tf_topic>/rover/ground_truth/tf</tf_topic>
    </plugin>
    <link name="camera_link">
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.000125</ixx>
          <iyy>0.000125</iyy>
          <izz>0.00016</izz>
        </inertia>
      </inertial>
      <collision name="housing">
        <geometry>
          <box>
            <size>0.08 0.08 0.06</size>
          </box>
        </geometry>
      </collision>
      <visual name="housing_visual">
        <geometry>
          <box>
            <size>0.08 0.08 0.06</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
      <sensor name="surround_front_sensor" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/cameras/surround_front/image</topic>
        <camera>
          <camera_info_topic>/cameras/surround_front/camera_info</camera_info_topic>
          <optical_frame_id>camera_optical_frame</optical_frame_id>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50</far>
          </clip>
        </camera>
        <pose>0.045 0 0 0 0 0</pose>
      </sensor>
      <pose relative_to="base_link">0.30 0 0.18 0 0 0</pose>
    </link>
    <joint name="camera_mount" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>
    <link name="lidar_link">
      <inertial>
        <mass>0.30</mass>
        <inertia>
          <ixx>0.00025</ixx>
          <iyy>0.00025</iyy>
          <izz>0.000375</izz>
        </inertia>
      </inertial>
      <collision name="housing">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="housing_visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.20 0.22 1</ambient>
          <diffuse>0.15 0.20 0.22 1</diffuse>
        </material>
      </visual>
      <sensor name="gpu_lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/rover/lidar</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>1800</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265359</min_angle>
              <max_angle>3.14159265359</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples>
              <resolution>1</resolution>
              <min_angle>-0.261799</min_angle>
              <max_angle>0.523599</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>30</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
        <pose>0 0 0.03 0 0 0</pose>
      </sensor>
      <pose relative_to="base_link">0 0 0.28 0 0 0</pose>
    </link>
    <joint name="lidar_mount" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>
    <link name="imu_link">
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <iyy>0.000001</iyy>
          <izz>0.0000013</izz>
        </inertia>
      </inertial>
      <collision name="housing">
        <geometry>
          <box>
            <size>0.02 0.02 0.01</size>
          </box>
        </geometry>
      </collision>
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/imu</topic>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0002</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0002</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0002</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.017</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.017</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.017</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
        <pose>0 0 0 0 0 0</pose>
      </sensor>
      <pose relative_to="base_link">0 0 0.11 0 0 0</pose>
    </link>
    <joint name="imu_mount" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>
    <link name="gnss_link">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00002</izz>
        </inertia>
      </inertial>
      <collision name="housing">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="housing_visual">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>0.9 0.9 0.9 1</diffuse>
        </material>
      </visual>
      <sensor name="gnss_sensor" type="navsat">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>/gnss/fix</topic>
        <navsat>
          <position_sensing>
            <horizontal>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00000018</stddev>
              </noise>
            </horizontal>
            <vertical>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.04</stddev>
              </noise>
            </vertical>
          </position_sensing>
        </navsat>
        <pose>0 0 0 0 0 0</pose>
      </sensor>
      <pose relative_to="base_link">-0.18 0 0.20 0 0 0</pose>
    </link>
    <joint name="gnss_mount" type="fixed">
      <parent>base_link</parent>
      <child>gnss_link</child>
    </joint>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/rover/wheel_joint_states</topic>
      <update_rate>50</update_rate>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
  </model>
</sdf>