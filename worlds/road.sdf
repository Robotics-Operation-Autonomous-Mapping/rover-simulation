<?xml version="1.0"?>
<sdf version="1.9">
  <world name="road">

    <!-- Physics -->
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Sunlight -->
    <light name="sun" type="directional">
      <pose>0 0 15 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 -0.5 -1</direction>
    </light>

    <!-- Surrounding grassy ground -->
    <model name="grass">
      <static>true</static>
      <pose>0 0 -0.15 0 0 0</pose>
      <link name="ground_link">

        <collision name="collision">
          <geometry>
            <box><size>80 40 0.3</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>80 40 0.3</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.45 0.15 1</ambient>
            <diffuse>0.2 0.45 0.15 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- Asphalt road -->
    <model name="asphalt">
      <static>true</static>
      <pose>0 0 0.025 0 0 0</pose>
      <link name="road_link">

        <collision name="collision">
          <geometry>
            <box><size>60 8 0.05</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>60 8 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.12 0.12 0.13 1</ambient>
            <diffuse>0.12 0.12 0.13 1</diffuse>
          </material>
        </visual>

        <!-- White road edge lines -->
        <visual name="left_edge">
          <pose>0 3.7 0.028 0 0 0</pose>
          <geometry>
            <box><size>60 0.12 0.005</size></box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>

        <visual name="right_edge">
          <pose>0 -3.7 0.028 0 0 0</pose>
          <geometry>
            <box><size>60 0.12 0.005</size></box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>

        <!-- Dashed yellow center line -->
        <visual name="dash_1">
          <pose>-25 0 0.028 0 0 0</pose>
          <geometry><box><size>3 0.15 0.005</size></box></geometry>
          <material>
            <ambient>1 0.8 0.05 1</ambient>
            <diffuse>1 0.8 0.05 1</diffuse>
          </material>
        </visual>

        <visual name="dash_2">
          <pose>-15 0 0.028 0 0 0</pose>
          <geometry><box><size>3 0.15 0.005</size></box></geometry>
          <material>
            <ambient>1 0.8 0.05 1</ambient>
            <diffuse>1 0.8 0.05 1</diffuse>
          </material>
        </visual>

        <visual name="dash_3">
          <pose>-5 0 0.028 0 0 0</pose>
          <geometry><box><size>3 0.15 0.005</size></box></geometry>
          <material>
            <ambient>1 0.8 0.05 1</ambient>
            <diffuse>1 0.8 0.05 1</diffuse>
          </material>
        </visual>

        <visual name="dash_4">
          <pose>5 0 0.028 0 0 0</pose>
          <geometry><box><size>3 0.15 0.005</size></box></geometry>
          <material>
            <ambient>1 0.8 0.05 1</ambient>
            <diffuse>1 0.8 0.05 1</diffuse>
          </material>
        </visual>

        <visual name="dash_5">
          <pose>15 0 0.028 0 0 0</pose>
          <geometry><box><size>3 0.15 0.005</size></box></geometry>
          <material>
            <ambient>1 0.8 0.05 1</ambient>
            <diffuse>1 0.8 0.05 1</diffuse>
          </material>
        </visual>

        <visual name="dash_6">
          <pose>25 0 0.028 0 0 0</pose>
          <geometry><box><size>3 0.15 0.005</size></box></geometry>
          <material>
            <ambient>1 0.8 0.05 1</ambient>
            <diffuse>1 0.8 0.05 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- Roadside obstacles -->
    <model name="roadside_posts">
      <static>true</static>
      <link name="posts">

        <visual name="post_1">
          <pose>-20 5 0.6 0 0 0</pose>
          <geometry><box><size>0.3 0.3 1.2</size></box></geometry>
        </visual>
        <collision name="post_1_collision">
          <pose>-20 5 0.6 0 0 0</pose>
          <geometry><box><size>0.3 0.3 1.2</size></box></geometry>
        </collision>

        <visual name="post_2">
          <pose>0 5 0.6 0 0 0</pose>
          <geometry><box><size>0.3 0.3 1.2</size></box></geometry>
        </visual>
        <collision name="post_2_collision">
          <pose>0 5 0.6 0 0 0</pose>
          <geometry><box><size>0.3 0.3 1.2</size></box></geometry>
        </collision>

        <visual name="post_3">
          <pose>20 5 0.6 0 0 0</pose>
          <geometry><box><size>0.3 0.3 1.2</size></box></geometry>
        </visual>
        <collision name="post_3_collision">
          <pose>20 5 0.6 0 0 0</pose>
          <geometry><box><size>0.3 0.3 1.2</size></box></geometry>
        </collision>

      </link>
    </model>

  </world>
</sdf>
