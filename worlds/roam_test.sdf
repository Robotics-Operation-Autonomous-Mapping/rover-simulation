<?xml version="1.0"?>
<sdf version="1.10">
  <world name="roam_test">
    <gravity>0 0 -9.81</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.82 0.88 0.95 1</background></scene>
    <light name="sun" type="directional"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><specular>0.4 0.4 0.4 1</specular><direction>-0.5 -0.3 -1</direction></light>
    <model name="ground"><static>true</static><link name="ground_link"><collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision><visual name="ground_visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><ambient>0.45 0.49 0.45 1</ambient><diffuse>0.45 0.49 0.45 1</diffuse></material></visual></link></model>
    <include><uri>model://roam_rover</uri><pose>0 0 0.23 0 0 0</pose></include>
  </world>
</sdf>
