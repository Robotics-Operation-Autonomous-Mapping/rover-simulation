<?xml version="1.0"?>
<sdf version="1.9">
  <model name="basic_rover">
    <!-- Spawn just above the ground. Front is +x, left is +y, up is +z. -->
    <pose>0 0 0.025 0 0 0</pose>
    <static>false</static>
    <self_collide>false</self_collide>

    <link name="chassis">
      <pose>0 0 0.28 0 0 0</pose>
      <inertial>
        <mass>6</mass>
        <inertia>
          <ixx>0.1378</ixx><iyy>0.3328</iyy><izz>0.445</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry><box><size>0.80 0.50 0.16</size></box></geometry>
      </collision>
      <visual name="chassis_visual">
        <geometry><box><size>0.80 0.50 0.16</size></box></geometry>
        <material>
          <ambient>0.85 0.58 0.10 1</ambient>
          <diffuse>0.95 0.68 0.12 1</diffuse>
        </material>
      </visual>
      <!-- A green strip on the top marks the front of the rover. -->
      <visual name="front_marker">
        <pose>0.345 0 0.082 0 0 0</pose>
        <geometry><box><size>0.05 0.40 0.004</size></box></geometry>
        <material>
          <ambient>0.10 0.75 0.20 1</ambient>
          <diffuse>0.15 0.95 0.25 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Wheel radius: 0.14 m. Width: 0.07 m. Axles are parallel to +y.
         The link frames stay aligned with the model; only the cylinder
         geometry is rotated from its default z axis onto the y axis. -->
    <link name="front_left_wheel">
      <pose>0.28 0.29 0.14 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.00265417</ixx><iyy>0.0049</iyy><izz>0.00265417</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="wheel_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>0.07</length></cylinder></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <visual name="wheel_visual">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>0.07</length></cylinder></geometry>
        <material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.16 0.16 0.18 1</diffuse></material>
      </visual>
    </link>

    <link name="front_right_wheel">
      <pose>0.28 -0.29 0.14 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.00265417</ixx><iyy>0.0049</iyy><izz>0.00265417</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="wheel_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>0.07</length></cylinder></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <visual name="wheel_visual">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>0.07</length></cylinder></geometry>
        <material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.16 0.16 0.18 1</diffuse></material>
      </visual>
    </link>

    <link name="rear_left_wheel">
      <pose>-0.28 0.29 0.14 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.00265417</ixx><iyy>0.0049</iyy><izz>0.00265417</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="wheel_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>0.07</length></cylinder></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <visual name="wheel_visual">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>0.07</length></cylinder></geometry>
        <material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.16 0.16 0.18 1</diffuse></material>
      </visual>
    </link>

    <link name="rear_right_wheel">
      <pose>-0.28 -0.29 0.14 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.00265417</ixx><iyy>0.0049</iyy><izz>0.00265417</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="wheel_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>0.07</length></cylinder></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <visual name="wheel_visual">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>0.07</length></cylinder></geometry>
        <material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.16 0.16 0.18 1</diffuse></material>
      </visual>
    </link>

    <!-- Wheel axes are +y; positive rotation drives the rover forwards. -->
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>chassis</parent><child>front_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <!-- Finite bounds avoid locked wheel motors with DART's infinite defaults. -->
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.02</damping></dynamics>
      </axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>chassis</parent><child>front_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <!-- Finite bounds avoid locked wheel motors with DART's infinite defaults. -->
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.02</damping></dynamics>
      </axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent><child>rear_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <!-- Finite bounds avoid locked wheel motors with DART's infinite defaults. -->
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.02</damping></dynamics>
      </axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent><child>rear_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <!-- Finite bounds avoid locked wheel motors with DART's infinite defaults. -->
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.02</damping></dynamics>
      </axis>
    </joint>

    <!-- Four-wheel skid steering using Gazebo Transport, with no ROS nodes. -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.58</wheel_separation>
      <wheel_radius>0.14</wheel_radius>
      <topic>/rover/cmd_vel</topic>
      <odom_topic>/rover/odometry</odom_topic>
      <tf_topic>/rover/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>chassis</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <min_linear_velocity>-1.0</min_linear_velocity>
      <max_linear_velocity>1.0</max_linear_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
    </plugin>
    <!-- Actual simulated angles / velocities for the ROS encoder bridge. -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/rover/wheel_joint_states</topic>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
  </model>
</sdf>
