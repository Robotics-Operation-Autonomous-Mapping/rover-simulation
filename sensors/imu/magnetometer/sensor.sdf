<link name="housing">
  <inertial>
    <mass>0.000001</mass>
    <inertia>
      <ixx>1e-12</ixx>
      <iyy>1e-12</iyy>
      <izz>1e-12</izz>
    </inertia>
  </inertial>
  <sensor name="sensor" type="magnetometer">
    <always_on />
    <update_rate />
    <topic />
    <magnetometer>
      <x>
        <noise type="gaussian">
          <mean />
          <stddev />
        </noise>
      </x>
      <y>
        <noise type="gaussian">
          <mean />
          <stddev />
        </noise>
      </y>
      <z>
        <noise type="gaussian">
          <mean />
          <stddev />
        </noise>
      </z>
    </magnetometer>
  </sensor>
</link>
