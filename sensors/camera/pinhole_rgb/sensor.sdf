<link name="housing">
  <inertial>
    <mass>0.15</mass>
    <inertia>
      <ixx>0.000125</ixx>
      <iyy>0.000125</iyy>
      <izz>0.00016</izz>
    </inertia>
  </inertial>
  <collision name="housing">
    <geometry>
      <box>
        <size>0.08 0.08 0.06</size>
      </box>
    </geometry>
  </collision>
  <visual name="housing_visual">
    <geometry>
      <box>
        <size>0.08 0.08 0.06</size>
      </box>
    </geometry>
    <material>
      <ambient>0.08 0.08 0.08 1</ambient>
      <diffuse>0.08 0.08 0.08 1</diffuse>
