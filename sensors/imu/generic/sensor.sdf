<link name="housing">
  <inertial>
    <mass>0.02</mass>
    <inertia>
      <ixx>0.000001</ixx>
      <iyy>0.000001</iyy>
      <izz>0.0000013</izz>
    </inertia>
  </inertial>
  <collision name="housing">
    <geometry>
      <box>
        <size>0.02 0.02 0.01</size>
      </box>
    </geometry>
  </collision>
  <sensor name="sensor" type="imu">
    <always_on />
    <update_rate />
    <topic />
    <imu>
      <angular_velocity>
        <x>
          <noise type="gaussian">
            <mean />
            <stddev />
          </noise>
        </x>
        <y>
          <noise type="gaussian">
            <mean />
            <stddev />
          </noise>
        </y>
        <z>
          <noise type="gaussian">
            <mean />
            <stddev />
          </noise>
        </z>
      </angular_velocity>
      <linear_acceleration>
        <x>
          <noise type="gaussian">
            <mean />
            <stddev />
          </noise>
        </x>
        <y>
          <noise type="gaussian">
            <mean />
            <stddev />
          </noise>
        </y>
        <z>
          <noise type="gaussian">
            <mean />
            <stddev />
          </noise>
        </z>
      </linear_acceleration>
    </imu>
  </sensor>
</link>
    
